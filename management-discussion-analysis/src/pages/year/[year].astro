---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allLetters = await getCollection('mda');

  // Group letters by year
  const yearsMap = new Map<number, typeof allLetters>();
  for (const letter of allLetters) {
    const y = letter.data.year;
    if (!yearsMap.has(y)) yearsMap.set(y, []);
    yearsMap.get(y)!.push(letter);
  }

  const sortedYears = Array.from(yearsMap.keys()).sort((a, b) => a - b);

  return Array.from(yearsMap.entries()).map(([year, letters]) => {
    const idx = sortedYears.indexOf(year);
    return {
      params: { year: String(year) },
      props: {
        year,
        // Sort by company name (Chinese collation) so order is stable
        letters: letters.sort((a, b) =>
          a.data.company.localeCompare(b.data.company, 'zh-CN')
        ),
        prevYear: idx > 0 ? sortedYears[idx - 1] : null,
        nextYear: idx < sortedYears.length - 1 ? sortedYears[idx + 1] : null,
      },
    };
  });
}

type LetterEntry = Awaited<ReturnType<typeof getCollection<'mda'>>>[number];

interface Props {
  year: number;
  letters: LetterEntry[];
  prevYear: number | null;
  nextYear: number | null;
}

const { year, letters, prevYear, nextYear } = Astro.props;
const base = import.meta.env.BASE_URL;

// Only the first company's report is server-rendered; the rest live on their
// canonical report pages and are fetched on demand when switching companies.
const FirstContent = letters.length > 0 ? (await letters[0].render()).Content : null;

const items = letters.map((letter) => ({
  companySlug: letter.slug.split('/')[0],
  companyName: letter.data.company,
  slug: letter.slug,
}));

const companyNames = items.map((i) => i.companyName);
const description = `${year} 年上市公司管理层讨论与分析：${companyNames.join('、')}。共 ${letters.length} 篇，可切换公司阅读全文。`;
---

{/* noindex until a year covers enough companies to stand as a real archive;
    the links remain crawlable (noindex, follow). */}
<BaseLayout
  title={`${year} 年管理层讨论与分析（${letters.length} 家公司）`}
  description={description}
  noindex={true}
  bodyClass="page-reader"
>
  <nav class="breadcrumb">
    <a href={base}>首页</a>
    <span class="breadcrumb__sep">/</span>
    <a href={`${base}all-years/`}>年份</a>
    <span class="breadcrumb__sep">/</span>
    <span>{year} 年</span>
  </nav>

  <div class="reader reader--by-year" id="reader">
    <nav class="reader__sidebar">
      <div class="reader__years">
        {items.map((item, i) => (
          <a
            class:list={["reader__year-btn", { "is-active": i === 0 }]}
            data-company={item.companySlug}
            href={`${base}report/${item.slug}/`}
          >
            {item.companyName}
          </a>
        ))}
      </div>
    </nav>

    <div class="reader__content" id="singleView">
      {FirstContent && (
        <article
          class:list={["reader__letter", "is-active"]}
          data-company={items[0].companySlug}
        >
          <div class="prose">
            <FirstContent />
          </div>
        </article>
      )}
      <article class="reader__letter" id="lazyView">
        <div class="prose" id="lazyProse"></div>
      </article>
    </div>
  </div>

  <nav class="hub-pager">
    {prevYear ? (
      <a href={`${base}year/${prevYear}/`}>← {prevYear} 年</a>
    ) : <span />}
    {nextYear ? (
      <a href={`${base}year/${nextYear}/`}>{nextYear} 年 →</a>
    ) : <span />}
  </nav>
</BaseLayout>

<style is:global>
  a.reader__year-btn {
    text-decoration: none;
  }
  .page-reader .hub-pager {
    margin-top: 16px;
  }
</style>

<script>
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('DOMContentLoaded', setup);

  let initialized = false;

  function setup() {
    if (initialized) return;
    initialized = true;

    const yearBtns = document.querySelectorAll<HTMLAnchorElement>('.reader__year-btn');
    const singleView = document.getElementById('singleView');
    const lazyView = document.getElementById('lazyView') as HTMLElement;
    const lazyProse = document.getElementById('lazyProse') as HTMLElement;
    if (!yearBtns.length || !singleView) return;

    let loadToken = 0;

    const cache = new Map<string, string>();
    document.querySelectorAll<HTMLElement>('.reader__letter[data-company]').forEach((a) => {
      const c = a.dataset.company;
      const p = a.querySelector('.prose');
      if (c && p && p.innerHTML.trim()) cache.set(c, p.innerHTML);
    });

    function getContent(companySlug: string): Promise<string> {
      if (cache.has(companySlug)) return Promise.resolve(cache.get(companySlug)!);
      const link = document.querySelector<HTMLAnchorElement>(
        `a.reader__year-btn[data-company="${companySlug}"]`
      );
      if (!link) return Promise.resolve('');
      return fetch(link.href)
        .then((r) => r.text())
        .then((html) => {
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const prose = doc.querySelector('article.prose');
          const content = prose ? prose.innerHTML : '<p>加载失败，请直接打开该公司页面。</p>';
          cache.set(companySlug, content);
          return content;
        })
        .catch(() => '<p>加载失败，请直接打开该公司页面。</p>');
    }

    function activateArticle(el: HTMLElement) {
      document.querySelectorAll<HTMLElement>('.reader__letter').forEach((a) => {
        a.classList.toggle('is-active', a === el);
      });
      singleView!.scrollTop = 0;
    }

    yearBtns.forEach((btn) => {
      btn.addEventListener('click', (e: MouseEvent) => {
        // Let modified clicks open the canonical report page normally
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();

        const slug = btn.dataset.company!;
        yearBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const embedded = document.querySelector<HTMLElement>(
          `.reader__letter[data-company="${slug}"]`
        );
        if (embedded) {
          activateArticle(embedded);
          return;
        }

        const token = ++loadToken;
        getContent(slug).then((html) => {
          if (token !== loadToken) return;
          lazyProse.innerHTML = html;
          activateArticle(lazyView);
        });
      });
    });
  }
</script>
