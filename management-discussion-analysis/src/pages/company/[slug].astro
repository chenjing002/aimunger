---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { makeExcerpt } from '../../utils/excerpt';
import { RELATED_LINKS } from '../../utils/related';

export async function getStaticPaths() {
  const allLetters = await getCollection('mda');

  // Group by company slug
  const companiesMap = new Map<string, { name: string; letters: typeof allLetters }>();

  for (const letter of allLetters) {
    const companySlug = letter.slug.split('/')[0];
    if (!companiesMap.has(companySlug)) {
      companiesMap.set(companySlug, { name: letter.data.company, letters: [] });
    }
    companiesMap.get(companySlug)!.letters.push(letter);
  }

  return Array.from(companiesMap.entries()).map(([slug, data]) => ({
    params: { slug },
    props: {
      companyName: data.name,
      letters: data.letters.sort((a, b) => b.data.year - a.data.year),
    },
  }));
}

interface Props {
  companyName: string;
  letters: Awaited<ReturnType<typeof getCollection<'mda'>>>;
}

const { slug } = Astro.params;
const { companyName, letters } = Astro.props;
const base = import.meta.env.BASE_URL;

// Load intro if one exists for this company
const allIntros = await getCollection('intros');
const introEntry = allIntros.find((e) => e.slug === slug) ?? null;
let IntroContent: any = null;
if (introEntry) {
  const rendered = await introEntry.render();
  IntroContent = rendered.Content;
}

const items = letters.map((letter) => ({
  year: letter.data.year,
  title: letter.data.title,
  slug: letter.slug,
  excerpt: makeExcerpt(letter.body),
}));

const years = letters.map((l) => l.data.year);
const minYear = Math.min(...years);
const maxYear = Math.max(...years);
const yearRange = minYear === maxYear ? `${minYear} 年` : `${minYear}–${maxYear} 年`;
const description = `${companyName}管理层讨论与分析合集，收录 ${letters.length} 篇（${yearRange}），按年份浏览并阅读全文。`;
const related = RELATED_LINKS[slug!] ?? [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '管理层讨论与分析', item: new URL(base, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: companyName, item: new URL(`${base}company/${slug}/`, Astro.site).href },
  ],
};
---

<BaseLayout
  title={`${companyName}管理层讨论与分析（${yearRange}）`}
  description={description}
  jsonLd={jsonLd}
>
  <nav class="breadcrumb">
    <a href={base}>首页</a>
    <span class="breadcrumb__sep">/</span>
    <span>{companyName}</span>
  </nav>

  <header class="hub-header">
    <h1 class="hub-header__title">{companyName}管理层讨论与分析</h1>
    <p class="hub-header__meta">{letters.length} 篇 · {yearRange}</p>
  </header>

  {IntroContent && (
    <section class="hub-intro">
      <h2 class="hub-section-title">综述</h2>
      <div class="prose">
        <IntroContent />
      </div>
    </section>
  )}

  <section>
    <h2 class="hub-section-title">全部年份</h2>
    <ol class="hub-list">
      {items.map((item) => (
        <li class="hub-item">
          <a href={`${base}report/${item.slug}/`} class="hub-item__link">
            <span class="hub-item__year">{item.year}</span>
            <span class="hub-item__body">
              <span class="hub-item__title">{item.title}</span>
              {item.excerpt && <span class="hub-item__excerpt">{item.excerpt}</span>}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {related.length > 0 && (
    <aside class="hub-related">
      <h2 class="hub-related__title">相关内容</h2>
      <ul>
        {related.map((r) => (
          <li><a href={r.href}>{r.label}</a></li>
        ))}
      </ul>
    </aside>
  )}
</BaseLayout>
