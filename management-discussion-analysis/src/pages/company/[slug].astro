---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allLetters = await getCollection('mda');

  // Group by company slug
  const companiesMap = new Map<string, { name: string; letters: typeof allLetters }>();

  for (const letter of allLetters) {
    const companySlug = letter.slug.split('/')[0];
    if (!companiesMap.has(companySlug)) {
      companiesMap.set(companySlug, { name: letter.data.company, letters: [] });
    }
    companiesMap.get(companySlug)!.letters.push(letter);
  }

  return Array.from(companiesMap.entries()).map(([slug, data]) => ({
    params: { slug },
    props: {
      companyName: data.name,
      letters: data.letters.sort((a, b) => b.data.year - a.data.year),
    },
  }));
}

interface Props {
  companyName: string;
  letters: Awaited<ReturnType<typeof getCollection<'mda'>>>;
}

const { slug } = Astro.params;
const { companyName, letters } = Astro.props;
const base = import.meta.env.BASE_URL;

// Load intro if one exists for this company
const allIntros = await getCollection('intros');
const introEntry = allIntros.find((e) => e.slug === slug) ?? null;
let IntroContent: any = null;
if (introEntry) {
  const rendered = await introEntry.render();
  IntroContent = rendered.Content;
}

// Only the initially visible document is server-rendered; the other years
// stay on their canonical report pages and are fetched on demand. This keeps
// the reader UX without duplicating every report's full text on this URL.
let FirstContent: any = null;
if (!IntroContent && letters.length > 0) {
  FirstContent = (await letters[0].render()).Content;
}

const years = letters.map((l) => l.data.year);
const minYear = Math.min(...years);
const maxYear = Math.max(...years);
const yearRange = minYear === maxYear ? `${minYear} 年` : `${minYear}–${maxYear} 年`;
const description = `${companyName}管理层讨论与分析合集，收录 ${letters.length} 篇（${yearRange}），按年份浏览、对比并阅读全文。`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '管理层讨论与分析', item: new URL(base, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: companyName, item: new URL(`${base}company/${slug}/`, Astro.site).href },
  ],
};
---

<BaseLayout
  title={`${companyName}管理层讨论与分析（${yearRange}）`}
  description={description}
  jsonLd={jsonLd}
  bodyClass="page-reader"
>
  <nav class="breadcrumb">
    <a href={base}>首页</a>
    <span class="breadcrumb__sep">/</span>
    <span>{companyName}</span>
  </nav>

  <div class="reader" id="reader">
    <nav class="reader__sidebar">
      <label class="compare-toggle">
        <input type="checkbox" class="compare-toggle__input" id="compareToggle" />
        <span class="compare-toggle__track">
          <span class="compare-toggle__thumb"></span>
        </span>
        <span class="compare-toggle__label">对比</span>
      </label>

      <div class="compare-hint" id="compareHint">选择2个年份 👇</div>

      <div class="reader__years">
        {IntroContent && (
          <button
            class:list={["reader__year-btn", "reader__year-btn--intro", "is-active"]}
            data-year="intro"
          >
            <span class="reader__year-dot"></span>
            <svg class="intro-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 1L14.59 9.41L24 12L14.59 14.59L12 23L9.41 14.59L0 12L9.41 9.41L12 1Z"/>
            </svg>
            综述
          </button>
        )}
        {letters.map((letter, i) => (
          <a
            class:list={["reader__year-btn", { "is-active": !IntroContent && i === 0 }]}
            data-year={letter.data.year}
            href={`${base}report/${letter.slug}/`}
          >
            <span class="reader__year-dot"></span>
            {letter.data.year}
          </a>
        ))}
      </div>
    </nav>

    <!-- Single report view -->
    <div class="reader__content" id="singleView">
      {IntroContent && (
        <article
          class:list={["reader__letter", "is-active"]}
          data-year="intro"
        >
          <div class="prose">
            <IntroContent />
          </div>
        </article>
      )}
      {!IntroContent && FirstContent && (
        <article
          class:list={["reader__letter", "is-active"]}
          data-year={letters[0].data.year}
        >
          <div class="prose">
            <FirstContent />
          </div>
        </article>
      )}
      <article class="reader__letter" id="lazyView">
        <div class="prose" id="lazyProse"></div>
      </article>
    </div>

    <!-- Compare view (two columns) -->
    <div class="reader__compare" id="compareView">
      <div class="reader__compare-col" id="compareLeft">
        <div class="reader__compare-year" id="compareLabelLeft"></div>
        <div class="reader__compare-body prose" id="compareBodyLeft"></div>
      </div>
      <div class="reader__compare-col" id="compareRight">
        <div class="reader__compare-year" id="compareLabelRight"></div>
        <div class="reader__compare-body prose" id="compareBodyRight"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .reader__year-btn--intro {
    color: var(--accent);
  }
  .reader__year-btn--intro:hover {
    color: var(--accent);
  }
  .reader__year-btn--intro.is-active {
    color: var(--accent);
  }
  .intro-icon {
    flex-shrink: 0;
    opacity: 0.75;
  }
  a.reader__year-btn {
    text-decoration: none;
  }
</style>

<script>
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('DOMContentLoaded', setup);

  let initialized = false;

  function setup() {
    if (initialized) return;
    initialized = true;

    const reader = document.getElementById('reader');
    const toggle = document.getElementById('compareToggle') as HTMLInputElement;
    const singleView = document.getElementById('singleView');
    const compareView = document.getElementById('compareView');
    const lazyView = document.getElementById('lazyView') as HTMLElement;
    const lazyProse = document.getElementById('lazyProse') as HTMLElement;
    const yearBtns = document.querySelectorAll<HTMLElement>('.reader__year-btn');

    if (!reader || !toggle || !yearBtns.length) return;

    let isComparing = false;
    let compareYears: string[] = [];
    let loadToken = 0;

    // ── Content loading ──────────────────────────────
    // Server-rendered articles seed the cache; every other year is fetched
    // from its canonical report page and the .prose HTML extracted.
    const cache = new Map<string, string>();
    document.querySelectorAll<HTMLElement>('.reader__letter[data-year]').forEach((a) => {
      const y = a.dataset.year;
      const p = a.querySelector('.prose');
      if (y && p && p.innerHTML.trim()) cache.set(y, p.innerHTML);
    });

    function getContent(year: string): Promise<string> {
      if (cache.has(year)) return Promise.resolve(cache.get(year)!);
      const link = document.querySelector<HTMLAnchorElement>(`a.reader__year-btn[data-year="${year}"]`);
      if (!link) return Promise.resolve('');
      return fetch(link.href)
        .then((r) => r.text())
        .then((html) => {
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const prose = doc.querySelector('article.prose');
          const content = prose ? prose.innerHTML : '<p>加载失败，请直接打开该年份页面。</p>';
          cache.set(year, content);
          return content;
        })
        .catch(() => '<p>加载失败，请直接打开该年份页面。</p>');
    }

    function activateArticle(el: HTMLElement) {
      document.querySelectorAll<HTMLElement>('.reader__letter').forEach((a) => {
        a.classList.toggle('is-active', a === el);
      });
      singleView!.scrollTop = 0;
    }

    // ── Single mode ──────────────────────────────────
    function handleSingleClick(btn: HTMLElement) {
      const year = btn.dataset.year!;
      yearBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const embedded = document.querySelector<HTMLElement>(
        `.reader__letter[data-year="${year}"]`
      );
      if (embedded) {
        activateArticle(embedded);
        return;
      }

      const token = ++loadToken;
      getContent(year).then((html) => {
        if (token !== loadToken) return;
        lazyProse.innerHTML = html;
        activateArticle(lazyView);
      });
    }

    // ── Compare mode ─────────────────────────────────
    function handleCompareClick(btn: HTMLElement) {
      const year = btn.dataset.year!;

      if (btn.classList.contains('is-active')) {
        // Deselect
        btn.classList.remove('is-active');
        compareYears = compareYears.filter((y) => y !== year);
      } else if (compareYears.length < 2) {
        // Select
        btn.classList.add('is-active');
        compareYears.push(year);
      } else {
        // Already 2 selected — replace the older one
        const oldest = compareYears.shift()!;
        yearBtns.forEach((b) => {
          if (b.dataset.year === oldest) b.classList.remove('is-active');
        });
        btn.classList.add('is-active');
        compareYears.push(year);
      }

      updateCompareView();
    }

    function fillCol(labelEl: HTMLElement, bodyEl: HTMLElement, colEl: HTMLElement, year: string | null) {
      colEl.dataset.year = year ?? '';
      if (!year) {
        labelEl.textContent = '';
        bodyEl.innerHTML = '';
        colEl.classList.remove('has-content');
        return;
      }
      labelEl.textContent = year === 'intro' ? '综述' : year + '年';
      colEl.classList.add('has-content');
      getContent(year).then((html) => {
        if (colEl.dataset.year !== year) return;
        bodyEl.innerHTML = html;
        colEl.scrollTop = 0;
      });
    }

    function updateCompareView() {
      const leftLabel = document.getElementById('compareLabelLeft')!;
      const rightLabel = document.getElementById('compareLabelRight')!;
      const leftBody = document.getElementById('compareBodyLeft')!;
      const rightBody = document.getElementById('compareBodyRight')!;
      const leftCol = document.getElementById('compareLeft')!;
      const rightCol = document.getElementById('compareRight')!;

      // Sort: put intro first if selected, otherwise newer year on left
      const sorted = [...compareYears].sort((a, b) => {
        if (a === 'intro') return -1;
        if (b === 'intro') return 1;
        return Number(b) - Number(a);
      });
      const [left, right] = sorted;

      fillCol(leftLabel, leftBody, leftCol, left ?? null);
      fillCol(rightLabel, rightBody, rightCol, right ?? null);

      compareView!.classList.toggle('has-content', compareYears.length > 0);
    }

    // ── Toggle handler ───────────────────────────────
    toggle.addEventListener('change', () => {
      isComparing = toggle.checked;
      reader.classList.toggle('is-comparing', isComparing);

      if (isComparing) {
        // Enter compare mode — pre-select the first two entries
        compareYears = [];
        yearBtns.forEach((b) => b.classList.remove('is-active'));
        if (yearBtns.length >= 2) {
          yearBtns[0].classList.add('is-active');
          yearBtns[1].classList.add('is-active');
          compareYears = [yearBtns[0].dataset.year!, yearBtns[1].dataset.year!];
        }
        updateCompareView();
      } else {
        // Exit compare mode — select the first entry
        compareYears = [];
        yearBtns.forEach((b, i) => b.classList.toggle('is-active', i === 0));
        if (yearBtns.length) handleSingleClick(yearBtns[0]);
      }
    });

    // ── Year entry click ─────────────────────────────
    yearBtns.forEach((btn) => {
      btn.addEventListener('click', (e: MouseEvent) => {
        // Let modified clicks open the canonical report page normally
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        if (isComparing) {
          handleCompareClick(btn);
        } else {
          handleSingleClick(btn);
        }
      });
    });
  }
</script>
